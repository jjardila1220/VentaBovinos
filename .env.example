DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=carnes
DATABASE_USER=postgres
DATABASE_PASSWORD=tu_contrasena_aqui
SESSION_SECRET=cambiar_este_secreto_en_produccion_por_uno_seguro

# --- Integración con Semillas del Valle (API Django) ---
# Cuenta de ADMINISTRADOR de Semillas usada solo por el servidor (use una cuenta dedicada).
SEMILLAS_API_URL=http://127.0.0.1:8000/api
SEMILLAS_API_EMAIL=
SEMILLAS_API_PASSWORD=
# Opcionales: tiempo máximo por petición (ms) y caché de reportes (segundos, 0 = sin caché)
SEMILLAS_API_TIMEOUT_MS=8000
SEMILLAS_CACHE_TTL_SECONDS=30
# En producción se exige https; solo para redes internas confiables:
# SEMILLAS_API_ALLOW_HTTP=true
